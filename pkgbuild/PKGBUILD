pkgname=quickref
pkgver=0.1.0
pkgrel=1
pkgdesc='A drop-down Markdown reference for Linux and DevOps notes'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-utils' 'glib2')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() {
 cd "$startdir/.."
 ./bin/build
}
package() {
 cd "$startdir/.."
 install -Dm755 build/quickref "$pkgdir/usr/bin/quickref"
 install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 install -Dm644 pkgbuild/quickref.desktop "$pkgdir/usr/share/applications/quickref.desktop"
 install -Dm644 pkgbuild/quickref.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quickref.svg"
 install -Dm644 integration/quickref.lua "$pkgdir/usr/share/quickref/quickref.lua"
 install -d "$pkgdir/usr/share/quickref/examples"
 install -m644 examples/*.md "$pkgdir/usr/share/quickref/examples/"
}
